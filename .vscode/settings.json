{
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "eslint.validate": [
        "css",
        "html",
        "json",
        "javascript"
    ],
    "files.associations": {
        "*.liquid": "html"
    },
    "files.encoding": "utf8",
    "workbench.tree.indent": 14
}
